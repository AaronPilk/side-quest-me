{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "shared",
    "worker",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "tests",
    "playwright.config.ts",
    "vite.ios.config.ts",
    "scripts/ai-eval.config.ts",
    "scripts/eval-quest-ai.live.ts",
    "capacitor.config.ts"
  ],
  "exclude": ["node_modules", "dist", "dist-ios", "ios"]
}
