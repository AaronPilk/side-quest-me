{
  "name": "sidequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --mode demo --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host 127.0.0.1",
    "render:dev": "node renderer/server.mjs",
    "render:fixtures": "node scripts/render-fixtures.mjs",
    "test:db": "node scripts/db-test.mjs",
    "test:db:advisors": "node scripts/db-test.mjs --advisors",
    "format": "prettier --write .",
    "test:api": "node scripts/api-smoke.mjs",
    "db:types": "node scripts/db-test.mjs --generate-types",
    "ios:build": "vite build --config vite.ios.config.ts --mode ios",
    "ios:build:demo": "vite build --config vite.ios.config.ts --mode ios-demo",
    "ios:sync": "npm run ios:build && cap sync ios",
    "ios:sync:demo": "npm run ios:build:demo && cap sync ios",
    "ios:open": "cap open ios",
    "ios:verify:release": "node scripts/verify-ios-release.mjs",
    "ios:simulator": "node scripts/run-ios-simulator.mjs",
    "test:ai:live": "vitest run --config scripts/ai-eval.config.ts"
  },
  "dependencies": {
    "@apple/mapkit-loader": "1.0.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@cloudflare/containers": "0.3.7",
    "@supabase/supabase-js": "2.117.2",
    "hono": "4.13.9",
    "jose": "6.2.12",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@cloudflare/vite-plugin": "1.61.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  }
}
