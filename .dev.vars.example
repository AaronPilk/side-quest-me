SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
RENDERER_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SERVER_ONLY_SECRET
REDEMPTION_SIGNING_KEY=REPLACE_WITH_RANDOM_SERVER_ONLY_SECRET
SHARE_SIGNING_KEY=REPLACE_WITH_DIFFERENT_RANDOM_SERVER_ONLY_SECRET

# Optional public, domain-restricted MapKit JS token from Apple Developer. Never put a .p8 private key here.
APPLE_MAPS_TOKEN=

# Optional server-only Ticketmaster Discovery key for nearby Ticketmaster / Universe / Front Gate listings.
TICKETMASTER_API_KEY=

# Optional server-only AI filming and original-draft proposals.
# Never use a VITE_ prefix or put a key in the iOS app.
# Publish the key separately as a Worker secret when deployment is authorized.
AI_QUEST_PROVIDER=openai
AI_QUEST_MODEL=gpt-6-astra
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Existing OPENAI_QUEST_MODEL remains supported when provider=openai and AI_QUEST_MODEL is empty.
OPENAI_QUEST_MODEL=
