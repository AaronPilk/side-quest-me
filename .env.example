# Browser-public settings only. No service-role key belongs here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Optional public, domain-restricted MapKit JS token from Apple Developer. Never put a .p8 private key here.
APPLE_MAPS_TOKEN=

# Demo server only; never use a VITE_ prefix for this secret.
TICKETMASTER_API_KEY=
